# Google Gemini API key (leave empty to safely use deterministic authored fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_PATH=backend/debugdojo.db
SANDBOX_MODE=docker
MAX_PARALLEL_RUNS=4

# Allowed CORS origins as a comma-separated list of origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional CORS origin regular expression (e.g. ^https://.*\.debugdojo\.app$)
# Passed to FastAPI CORSMiddleware as allow_origin_regex
# Leave empty by default to prevent guessing frontend origins
CORS_ORIGIN_REGEX=
